#include <linux/module.h>
#include <linux/init.h>
#include <linux/kernel.h>
#include <linux/string.h>
#include <linux/limits.h>
#include <linux/list.h>
#include <linux/slab.h>

struct stack_node {
	int data;
	struct list_head list;
};

struct list_head stack_head;

int stack_peek(struct list_head *head) {
    if (list_empty(head)) {
        return -1;
    }
    struct stack_node *top = list_first_entry(head, struct stack_node, list);
    return top->data;
}

void stack_push(struct list_head *head, int value);

static uint to_write = UINT_MAX;
MODULE_PARM_DESC(to_write, "index in the char aray to write");

static int set_index(const char *val, const struct kernel_param *kp)
{
	int ret;
	ret = kstrtouint(val, 10, &to_write);
	if (ret)
		return ret;
	stack_push(&stack_head, to_write);
	pr_info("peek element: %d \n",stack_peek(&stack_head));
	return 0;
}

static int get_index(char *buf, const struct kernel_param *kp)
{
	return sprintf(buf, "%u", to_write);
}

static const struct kernel_param_ops set_index_params = {
	.set = set_index,
	.get = get_index,
};

module_param_cb(to_write, &set_index_params, &to_write, 0660);


void stack_push(struct list_head *head, int value)
{
	struct stack_node *new_stack_node = kmalloc(sizeof(struct stack_node), GFP_KERNEL);
	if (!new_stack_node)
		return;
	new_stack_node->data = value;
	INIT_LIST_HEAD(&new_stack_node->list);
	list_add(&new_stack_node->list, head);
}

static int __init hello_init(void)
{
	pr_info("%s: init: Module loaded!\n", KBUILD_MODNAME);
	INIT_LIST_HEAD(&stack_head);
	return 0;
}

static void __exit hello_exit(void)
{
	struct stack_node *node;
    struct list_head *pos, *tmp;

    list_for_each_safe(pos, tmp, &stack_head) {
        node = list_entry(pos, struct stack_node, list);
        list_del(pos);
        kfree(node);
    }
	pr_info("%s: exit: Module unloaded!\n", KBUILD_MODNAME);
}

module_init(hello_init);
module_exit(hello_exit);

MODULE_LICENSE("GPL");
MODULE_AUTHOR("Alex V");
MODULE_DESCRIPTION("Homework 2");
MODULE_VERSION("1.0");
